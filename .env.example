# ===========================================================================
# Trader — example environment file
# ===========================================================================
# Copy this file to `.env` and fill in real values:
#
#   Copy-Item .env.example .env
#
# `.env` is git-ignored. NEVER commit it. NEVER paste real keys into chat,
# issues, screenshots or logs.
# ===========================================================================


# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# One async URL for both the application and Alembic. Two URLs would mean two
# places where the same password can diverge or leak.
#
# Running locally without Docker: host is localhost.
# Running via docker compose: the backend service overrides this with host "db".
DATABASE_URL=postgresql+asyncpg://trader:CHANGE_ME@localhost:5432/trader
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Used by the PostgreSQL container in docker-compose. Must match DATABASE_URL.
POSTGRES_USER=trader
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=trader


# ---------------------------------------------------------------------------
# Trading identity — see docs/SRS.md section 4
# ---------------------------------------------------------------------------
REPORTING_CURRENCY=RON
EXCHANGE_QUOTE_CURRENCY=USDT
TRADING_TIMEZONE=Europe/Bucharest


# ---------------------------------------------------------------------------
# Autonomy mode
# ---------------------------------------------------------------------------
# SIGNAL_ONLY      — analyse and propose, never submit an order
# PAPER_AUTOMATIC  — decide and execute against the paper adapter only
# LIVE_AUTOMATIC   — real money; requires ALL live guards below
AUTONOMY_MODE=SIGNAL_ONLY


# ---------------------------------------------------------------------------
# LIVE TRADING GUARDS — read docs/SRS.md section 7 before touching these
# ---------------------------------------------------------------------------
# Live trading requires FOUR independent conditions. Changing one variable is
# never enough, by design:
#
#   1. AUTONOMY_MODE=LIVE_AUTOMATIC
#   2. LIVE_TRADING_ENABLED=true
#   3. LIVE_TRADING_CONFIRMATION_PHRASE set to the exact phrase below
#   4. A runtime operator confirmation through the API (added in Phase 11)
#
# If any condition is missing, the application refuses to start in live mode.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION_PHRASE=
# Expected value when you really mean it: I UNDERSTAND LIVE TRADING RISKS


# ---------------------------------------------------------------------------
# Binance credentials — NOT required before Phase 11
# ---------------------------------------------------------------------------
# Leave empty for Phases 1-10. Public market data needs no authentication.
# Use SEPARATE key pairs for paper/testnet and live. Never reuse a live key
# for testing. Restrict keys by IP where the exchange supports it.
# Required permissions: spot trading + read only.
# Forbidden permissions: withdrawal, futures, margin.
BINANCE_PAPER_API_KEY=
BINANCE_PAPER_API_SECRET=
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=


# ---------------------------------------------------------------------------
# Risk configuration bootstrap
# ---------------------------------------------------------------------------
# These values SEED the first RiskConfiguration row in the database.
# After seeding, the database is the single source of truth: every change is
# versioned and audited. Editing them here does not change a running system.
BOOTSTRAP_REFERENCE_CAPITAL_RON=1000.00
BOOTSTRAP_SESSION_TARGET_PERCENT=2.00
BOOTSTRAP_SESSION_RESTART_THRESHOLD_PERCENT=4.00
BOOTSTRAP_DAILY_MAXIMUM_LOSS_PERCENT=4.00
BOOTSTRAP_MAXIMUM_RISK_PER_TRADE_PERCENT=0.50
BOOTSTRAP_MAXIMUM_OPEN_POSITIONS=1
BOOTSTRAP_MAXIMUM_TRADES_PER_DAY=50
BOOTSTRAP_MAXIMUM_CONSECUTIVE_LOSSES=3
BOOTSTRAP_NO_NEW_ENTRY_MINUTES_BEFORE_DAY_END=30
# Empty means the daily profit floor is DISABLED (Phase 0 decision OD-03).
BOOTSTRAP_DAILY_PROFIT_GIVEBACK_PERCENT=


# ---------------------------------------------------------------------------
# FX — see docs/SRS.md section 5
# ---------------------------------------------------------------------------
FX_RATE_SOURCE=BNR
# Declared assumption, not a hidden constant. USDT is pegged to USD but is
# not USD. Stored with every FxRateSnapshot so historical reports stay exact.
USDT_USD_PEG=1.0000
